; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="warcraft3_map_editor"
run/main_scene="res://boot.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

LogPruner="*res://packages/foundation/logger/log_pruner.gd"
AssetProvider="*res://packages/content/asset_provider/asset_provider.gd"
EditorI18n="*res://packages/content/localization/editor_i18n.gd"
Wc3DefStore="*res://packages/content/stores/wc3_def_store.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="godot_warcraft3"

[editor_plugins]


[input]

toggle_console={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194334,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[internationalization]

locale/locale_filter_mode=0
locale/fallbacks=["en"]

[panku]

disable_on_release=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"

[warcraft3]
