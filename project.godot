; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="godot_warcraft3"
run/main_scene="uid://b20kj6oms7qoi"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/godot.log"

[autoload]

LogPruner="*res://core/logger/log_pruner.gd"
AssetProvider="*res://addons/asset_provider/asset_provider.gd"
EditorI18n="*res://editor/ui/editor_i18n.gd"
Wc3DefStore="*res://scripts/auto/wc3_def_store.gd"
Panku="*res://addons/panku_console/console.tscn"
GameplayAbilitySystem="*uid://u2lf4qtnkmft"
DamageCalculator="*uid://b2jxgcjagrkdx"
TagManager="*uid://crdi6238nttlg"
AbilityEventBus="*uid://dly4cms3ynkwf"
GameplayCueManager="*uid://b4t83autfu2j7"

[display]

window/subwindows/embed_subwindows=false
window/per_pixel_transparency/allowed=true

[dotnet]

project/assembly_name="godot_warcraft3"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ability_system/plugin.cfg", "res://addons/panku_console/plugin.cfg")

[internationalization]

locale/locale_filter_mode=0
locale/fallbacks=["en"]

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
