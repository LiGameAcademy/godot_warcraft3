# Godot 4+ specific ignores
.godot/
/android/

# WC3 asset pipeline — never commit Blizzard assets or extract output
# 老李 D3 决策 (2026-08-08)：任何 wc3 资源都不入 git
# 仓库只装：源码 / 工具 / 文档 / 配置文件
# 完整本地资源靠 tools/bootstrap.mjs 一键生成
.cache/
assets/.staging/
logs/
*.mpq
*.MPQ

# 误落在 assets 根下的 Blizzard 衍生树（正式车道是 asset-converted / slk-exported）
assets/Textures/
assets/units/
assets/ui/
assets/objects/
assets/_placeholders/

# Converted Godot-ready assets (PNG/GLTF/SCN + synced editor UI txt) — regenerate via tools
# Do NOT commit Blizzard content (see docs/data/LEGAL.md)
# .gdignore 例外：必须入库，否则 Godot 会 auto-import 并生成 baseColor / .import 副产物
assets/asset-converted/**
!assets/asset-converted/.gdignore

# Legacy model-scenes/ (deprecated: .scn now sits next to GLB under asset-converted/)
assets/model-scenes/**

# PE2 particle prefabs (*.pe2.tscn) — regenerated from tools/asset-convert
# 老李 D3：之前 tracked (注释"OK to commit")，改 ignored
assets/pe2-prefabs/**

# Building visual scenes (Bake output) — regenerated from tools/export_visual_scenes
# 老李 D3：改 ignored
assets/visuals/**

# Parsed map JSON — regenerate via tools/map-parse
assets/map-parsed/**

# Exported SLK tables (JSON) — regenerate via tools/slk-export
# 老李 D3：去 CSV（slk-export package.json 已只有 export JSON）
assets/slk-exported/**

# 本地模型沙箱（从 asset-converted 复制，供编辑器查看；含 Blizzard 衍生资源）
dev/model_sandbox/**
!dev/model_sandbox/**/
!dev/model_sandbox/**/README.md

# Node.js (tools/*)
node_modules/
# StormLib：npm postinstall / fetch-stormlib 下载，勿提交二进制与解压头文件
tools/mpq-extract/vendor/stormlib/**
!tools/mpq-extract/vendor/stormlib/.gitkeep
tools/mpq-extract/tmp/
tools/asset-convert/tmp/
# asset-convert ad-hoc validation outputs (e.g. tmp-validate_Footman.png)
tools/asset-convert/tmp-validate*
tools/map-parse/tmp/
# reconvert-additive-geosets 扫描缓存（本地生成）
tools/asset-convert/scripts/_additive_geoset_hits.json

# Mod content (keep mods/.gitkeep only)
mods/**
!mods/.gitkeep

# Local developer settings (absolute paths, etc.)
user_settings.local.json
/.vscode

# Local reference clones (e.g. HiveWE for analysis)
_ref/
.claude/settings.json

tmp/

dev/model_sandbox/**

wc3/

# Local WC3-derived model experiments; keep source assets out of Git.
assets/model-experiments/

# D4: generated package sync into app shells (run Sync-Packages.ps1)
apps/*/packages/
apps/*/addons/
apps/*/assets/
apps/*/icon.svg
apps/*/icon.svg.import
apps/*/.workspace-sync.json
apps/*/override.cfg
apps/*/tests/
apps/game/tools/
apps/*/scripts/
apps/*/content/
apps/*/.godot/
apps/*/logs/
apps/*/tmp/
**/__pycache__/

# .NET / IDE generated output
**/bin/
**/obj/
**/.idea/

# Teaching manuscripts and publishing assets live outside this open-source repo.
# Ignore rules do not untrack files already committed to Git.
/docs/blog/
/docs/gameplay/
/docs/dev-log/zhihu-*.md
/docs/dev-log/images/
/docs/dev-log/2026-09-28-startup-review/
/docs/开发日志-视频-字幕/
/docs/design/game/NAVIGATION_DEVLOG_SCRIPT_*.md
/output/devlog-*/
/output/devlog-*-materials.zip
/tutorials/
/_tutorials/
