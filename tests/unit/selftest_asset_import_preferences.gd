extends SceneTree
const Preferences: GDScript = preload("res://app/asset_import_preferences.gd")

func _initialize() -> void:
	var args: PackedStringArray = PackedStringArray()
	assert(Preferences.needs_wizard(args))
	assert(Preferences.needs_wizard(PackedStringArray(["--asset-import-cache", "new-cache"])))
	assert(not Preferences.needs_wizard(PackedStringArray(["--warcraft-dir", "source"])))
	assert(not Preferences.needs_wizard(PackedStringArray(["--asset-import-manifest", "manifest"])))
	assert(Preferences.argument(PackedStringArray(["--asset-import-cache", "explicit"]), "--asset-import-cache", "remembered") == "explicit")
	assert(Preferences.argument(args, "--asset-import-cache", "remembered") == "remembered")
	var file: String = "user://preferences-test-%s.cfg" % Time.get_ticks_usec()
	assert(Preferences.save("cache", "source", "runtime", file) == OK)
	var config: ConfigFile = Preferences.read(file)
	assert(config.get_value("paths", "cache") == "cache")
	assert(config.get_value("paths", "source") == "source")
	assert(config.get_value("paths", "runtime") == "runtime")
	assert(DirAccess.remove_absolute(ProjectSettings.globalize_path(file)) == OK)
	var editor: PackedStringArray = Preferences.worker_args("batch", "result", true, "project")
	assert(editor == PackedStringArray(["--headless", "--path", "project", "--", "--asset-worker-batch", "batch", "--asset-worker-result", "result"]))
	var release: PackedStringArray = Preferences.worker_args("batch", "result", false, "unused")
	assert(not release.has("--path"))
	assert(release[1] == "--")
	print("PASS: shared startup policy, explicit path priority, local preferences and editor worker project")
	quit(0)
